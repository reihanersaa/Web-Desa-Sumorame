{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/privat/:path*" },
    { "source": "/", "destination": "/publik/index.html" },
    { "source": "/css/:path*", "destination": "/publik/css/:path*" },
    { "source": "/js/:path*", "destination": "/publik/js/:path*" },
    { "source": "/img/:path*", "destination": "/publik/img/:path*" },
    { "source": "/:page.html", "destination": "/publik/:page.html" }
  ]
}
