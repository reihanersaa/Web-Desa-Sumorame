{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/img/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/publik/index.html", "destination": "/", "permanent": true },
    { "source": "/publik/:page.html", "destination": "/:page", "permanent": true },
    { "source": "/privat/:page.html", "destination": "/admin/:page", "permanent": true },
    { "source": "/admin/:page.html", "destination": "/admin/:page", "permanent": true },
    { "source": "/:page.html", "destination": "/:page", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/publik/index.html" },
    { "source": "/css/:path*", "destination": "/publik/css/:path*" },
    { "source": "/js/:path*", "destination": "/publik/js/:path*" },
    { "source": "/img/:path*", "destination": "/publik/img/:path*" },
    { "source": "/admin/css/:path*", "destination": "/privat/css/:path*" },
    { "source": "/admin/js/:path*", "destination": "/privat/js/:path*" },
    { "source": "/admin/:page", "destination": "/privat/:page.html" },
    { "source": "/:page", "destination": "/publik/:page.html" }
  ]
}
